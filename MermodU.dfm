  object temp_script: TFDScript
    SQLScripts = <
      item
        SQL.Strings = (
          'DROP TABLE IF EXISTS mjegy_temp;'
          
            'CREATE TEMPORARY TABLE IF NOT EXISTS mjegy_temp AS (SELECT * FRO' +
            'M merlegjegy WHERE id=:id);')
      end>
    Connection = AF.Kapcs
    Params = <
      item
        Name = 'id'
        DataType = ftInteger
        ParamType = ptInput
      end>
    Macros = <>
    Left = 552
    Top = 40
  end
